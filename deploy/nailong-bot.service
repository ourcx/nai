[Unit]
Description=Nailong and Naiwa Feishu image classifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nailong-bot
Group=nailong-bot
WorkingDirectory=/opt/nailong-bot
EnvironmentFile=/etc/nailong-bot.env
Environment=MODEL_PATH=/opt/nailong-bot/artifacts/model.pt
Environment=MODEL_DEVICE=cpu
Environment=MODEL_THRESHOLD=0.60
Environment=BOT_STATE_DIR=/var/lib/nailong-bot
Environment=DAILY_REPORT_TIME=23:55
Environment=PYTHONUNBUFFERED=1
Environment=TORCH_NUM_THREADS=2
StateDirectory=nailong-bot
StateDirectoryMode=0750
ExecStart=/opt/nailong-bot/.venv/bin/nailong-bot
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryMax=1200M

[Install]
WantedBy=multi-user.target
