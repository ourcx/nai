[Unit]
Description=Nailong and Naiwa image gallery
After=network-online.target nailong-bot.service
Wants=network-online.target

[Service]
Type=simple
User=nailong-bot
Group=nailong-bot
WorkingDirectory=/opt/nailong-bot
EnvironmentFile=/etc/nailong-bot.env
Environment=BOT_STATE_DIR=/var/lib/nailong-bot
Environment=WEB_HOST=127.0.0.1
Environment=WEB_PORT=8765
Environment=PYTHONUNBUFFERED=1
StateDirectory=nailong-bot
StateDirectoryMode=0750
ExecStart=/opt/nailong-bot/.venv/bin/nailong-web
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryMax=256M

[Install]
WantedBy=multi-user.target
