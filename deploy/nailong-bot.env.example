LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=replace-me
LOG_LEVEL=INFO
MODEL_THRESHOLD=0.65
BOT_STATE_DIR=/var/lib/nailong-bot
WEB_HOST=127.0.0.1
WEB_PORT=8765
DAILY_REPORT_TIME=23:55
CATALOG_DOCUMENT_ID=FvjYdVrTZonOaIx3JGScmXtenYe
CATALOG_SECTION_BLOCK_ID=AU8wdDhUWo0NRWxjykLclKcCnRd
# 首次启用同步时，填写已经人工导入文档的图鉴 asset ID，防止重复追加。
CATALOG_BASELINE_ASSET_IDS=
CATALOG_SYNC_RETRY_SECONDS=60
# 群聊普通消息触发主动发图的概率；同一群两次发图间隔至少 2 小时。
RANDOM_PUSH_PROBABILITY=0.03
RANDOM_PUSH_COOLDOWN_SECONDS=7200
# 抖音奶龙/奶娃视频分享链接，用英文逗号分隔；留空则关闭自动发链接。
# 请只填写已人工确认可访问、内容合适的 https://v.douyin.com/... 或 https://www.douyin.com/... 链接。
DOUYIN_VIDEO_URLS=
# 群聊普通消息触发视频链接的概率；每个群在滚动一小时内最多发送 2 条。
DOUYIN_VIDEO_PUSH_PROBABILITY=0.4
DOUYIN_VIDEO_PUSH_WINDOW_SECONDS=3600
DOUYIN_VIDEO_PUSH_MAX_PER_WINDOW=2
# 自动接龙和主动奶图中，20% 转为带增益图的 Ultra HDR JPEG；设 0 关闭随机转换。
RANDOM_PUSH_HDR_PROBABILITY=0.2
# HDR 高光编码目标，实际亮度取决于屏幕和飞书是否保留增益图。
HDR_PEAK_NITS=1000
