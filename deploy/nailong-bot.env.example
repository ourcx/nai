LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=replace-me
# 留空沿用单飞书实例。多平台接入时配置 TOML 的绝对路径。
# 凭证只放环境文件，TOML 仅填写环境变量名。
BOT_ADAPTERS_CONFIG=
# 可选：神笔奶良的飞书 open_id。通常无需设置，机器人会在当前群成员中按名称发现它。
MILK_IMAGE_GENERATOR_OPEN_ID=
# 若群内名称不同可调整；留空则关闭自动委托出图。
MILK_IMAGE_GENERATOR_NAME=神笔奶良
# 接入 QQ 官方机器人“我是奶龙”时，设置其 AppSecret；AppID 在 bots TOML 中配置。
QQ_APP_SECRET=
LOG_LEVEL=INFO
MODEL_THRESHOLD=0.50
# 奶蛙优先版本的共享推理清单；显式留空则使用原 MobileNet 与独立豆包检测器。
MILK_MODEL_PATH=/opt/nailong-bot/artifacts/milk-release-20261031/manifest.json
# 独立豆包检测器。命中后静默拒绝收录，不在群内自动回复。
# 留空可禁用；默认使用模型 checkpoint 保存的 0.30 阈值。
DOUBAO_MODEL_PATH=/opt/nailong-bot/artifacts/doubao-detector-20261026/model.pt
DOUBAO_MODEL_THRESHOLD=
BOT_STATE_DIR=/var/lib/nailong-bot
WEB_HOST=127.0.0.1
WEB_PORT=8765
DAILY_REPORT_TIME=23:55
CATALOG_DOCUMENT_ID=FvjYdVrTZonOaIx3JGScmXtenYe
CATALOG_SECTION_BLOCK_ID=AU8wdDhUWo0NRWxjykLclKcCnRd
# 首次启用同步时，填写已经人工导入文档的图鉴 asset ID，防止重复追加。
CATALOG_BASELINE_ASSET_IDS=
CATALOG_SYNC_RETRY_SECONDS=60
# 群聊普通消息触发主动发图的概率；同一群两次发图间隔至少 2 小时。
RANDOM_PUSH_PROBABILITY=0.03
RANDOM_PUSH_COOLDOWN_SECONDS=7200
# 浏览器导出的抖音 Cookie JSON 绝对路径。配置后搜索指定话题；候选必须带“奶龙”或“奶蛙”
# 的结构化标签，并通过封面分类校验，才会发送。
# Cookie 是私密凭证，只放 /etc/ 等受限路径，绝不提交到仓库。
DOUYIN_COOKIE_FILE=/etc/nailong-douyin-cookies.json
# 要搜索的话题，用英文逗号分隔，# 前缀可写可不写。机器人先在有结果的话题间等概率选择。
DOUYIN_SEARCH_KEYWORDS=奶蛙,文艺复兴,豆奶
# 搜索结果在内存中缓存 15 分钟，避免每次普通群消息都请求抖音。
DOUYIN_SEARCH_CACHE_SECONDS=900
# 群聊普通消息触发视频链接的概率；每个群在滚动一小时内最多发送 2 条。
DOUYIN_VIDEO_PUSH_PROBABILITY=0.4
DOUYIN_VIDEO_PUSH_WINDOW_SECONDS=3600
DOUYIN_VIDEO_PUSH_MAX_PER_WINDOW=2
# 自动接龙和主动奶图中，20% 转为带增益图的 Ultra HDR JPEG；设 0 关闭随机转换。
RANDOM_PUSH_HDR_PROBABILITY=0.2
# HDR 高光编码目标，实际亮度取决于屏幕和飞书是否保留增益图。
HDR_PEAK_NITS=1000
