[Unit]
Description=Nailong GPT-SoVITS speech synthesis
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=nailong-tts
Group=nailong-tts
WorkingDirectory=/srv/nailong-tts/current
EnvironmentFile=/etc/nailong-tts.env
Environment=TTS_RELEASE_DIR=/srv/nailong-tts/current
Environment=TTS_STATE_DIR=/var/lib/nailong-tts
Environment=TTS_HOST=127.0.0.1
Environment=TTS_PORT=9880
Environment=TTS_NUM_THREADS=4
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
Environment=OPENBLAS_NUM_THREADS=4
Environment=TOKENIZERS_PARALLELISM=false
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=MPLCONFIGDIR=/var/cache/nailong-tts/matplotlib
Environment=NUMBA_CACHE_DIR=/var/cache/nailong-tts/numba
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/nailong-tts/.venv/bin/python /srv/nailong-tts/current/service.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=nailong-tts
CacheDirectory=nailong-tts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryHigh=6G
MemoryMax=8G
CPUQuota=400%
TasksMax=128

[Install]
WantedBy=multi-user.target
